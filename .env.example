# ─────────────────────────────────────────────
# SKYVION AI VOICE OPERATIONS PLATFORM
# Environment Variables
# ─────────────────────────────────────────────

# ── Server ──
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── MongoDB ──
MONGODB_URI=mongodb://localhost:27017/skyvoice

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── OpenAI ──
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Google Gemini (secondary reasoning + intent layer) ──
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ── ElevenLabs (Voice Synthesis) ──
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-default-voice-id

# ── Pinecone (Vector Database) ──
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=skyvoice-knowledge
PINECONE_ENVIRONMENT=your-pinecone-environment

# ── Google Cloud (Calendar + Gmail) ──
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# ── JWT Auth ──
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# ── Email ──
EMAIL_FROM=noreply@skyviontech.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
